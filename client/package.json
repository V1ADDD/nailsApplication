{
  "name": "@nails/source",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "nx run web:serve"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@fontsource-variable/manrope": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.2",
    "@angular-devkit/schematics": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@schematics/angular": "22.2.2",
    "@types/node": "26.6.2",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "nx": "23.2.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "smol-toml": "1.9.0",
    "nx": {
      "brace-expansion": "5.0.12",
      "axios": "1.20.0"
    }
  },
  "nx": {
    "name": "client",
    "targets": {
      "knip": {
        "command": "knip --no-progress",
        "cache": true,
        "inputs": [
          "default",
          {
            "externalDependencies": [
              "knip"
            ]
          }
        ],
        "outputs": []
      },
      "format-check": {
        "command": "prettier --check .",
        "cache": true,
        "inputs": [
          "default",
          {
            "externalDependencies": [
              "prettier"
            ]
          }
        ],
        "outputs": []
      },
      "format": {
        "command": "prettier --write ."
      }
    }
  }
}
