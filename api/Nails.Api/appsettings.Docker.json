{
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "MigrateOnStart": true,
    "MaxRetryCount": 5
  },
  "OpenApi": {
    "Enabled": true
  },
  "Security": {
    "RedirectToHttps": false,
    "SecureCookies": false,
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "Email": {
    "FromAddress": "no-reply@nails.local",
    "FromName": "Мастера рядом",
    "Host": "mailpit",
    "Port": 1025,
    "Security": "None",
    "UserName": "",
    "Password": ""
  },
  "Modules": {
    "Identity": {
      "Options": {
        "SignIn": {
          "RequireConfirmedEmail": false
        },
        "User": {
          "RequireUniqueEmail": false
        }
      },
      "Cookie": {
        "ExpireTimeSpan": "14.00:00:00",
        "SlidingExpiration": true,
        "Cookie": {
          "Name": "nails.session"
        }
      },
      "RateLimit": {
        "PermitLimit": 20,
        "Window": "00:01:00"
      },
      "PhoneCode": {
        "VerificationRequired": false,
        "Length": 6,
        "Lifetime": "00:05:00",
        "ResendInterval": "00:01:00",
        "MaxAttempts": 5
      },
      "Sms": {
        "RecipientDomain": "sms.local"
      },
      "Presence": {
        "TouchInterval": "00:01:00",
        "OnlineWindow": "00:05:00"
      }
    },
    "Help": {
      "Enabled": true,
      "DefaultLanguage": "ru",
      "ContentPath": "Modules/Help/Content",
      "Images": {
        "MaxBytes": 2097152,
        "CacheSeconds": 31536000,
        "ContentTypes": {
          ".png": "image/png"
        }
      }
    },
    "Support": {
      "Enabled": true,
      "RateLimit": {
        "PermitLimit": 5,
        "Window": "00:01:00"
      }
    },
    "Masters": {
      "Enabled": true,
      "Search": {
        "DefaultPageSize": 20,
        "MaxPageSize": 50,
        "PinLimit": 1000,
        "DefaultLatitude": 53.9038,
        "DefaultLongitude": 27.5567
      }
    }
  },
  "Demo": {
    "Enabled": false,
    "PhotoUrlFormat": "https://randomuser.me/api/portraits/women/{0}.jpg"
  }
}
