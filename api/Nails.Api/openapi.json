  "components": {
    "schemas": {
      "ConfirmEmailRequest": {
        "required": [
          "userId",
          "code"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "maxLength": 2048,
            "type": "string"
          }
        }
      },
      "CreateSupportTicketRequest": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 2000,
            "type": "string"
          },
          "contact": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateSupportTicketResponse": {
        "required": [
          "ticketId"
        ],
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "type": "string"
          }
        }
      },
      "HelpArticleResponse": {
        "required": [
          "id",
          "module",
          "title",
          "summary",
          "body"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HelpCompanyResponse": {
        "required": [
          "name",
          "email",
          "website"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        }
      },
      "HelpContentResponse": {
        "required": [
          "language",
          "languages",
          "site",
          "company",
          "articles"
        ],
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "site": {
            "$ref": "#/components/schemas/HelpSiteResponse"
          },
          "company": {
            "$ref": "#/components/schemas/HelpCompanyResponse"
          },
          "articles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HelpArticleResponse"
            }
          }
        }
      },
      "HelpSiteResponse": {
        "required": [
          "title",
          "description"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "ModulesResponse": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "displayName",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "maxLength": 200,
            "type": "string"
          },
          "email": {
            "maxLength": 256,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          }
        }
      },
      "RegisterResponse": {
        "required": [
          "requiresEmailConfirmation"
        ],
        "type": "object",
        "properties": {
          "requiresEmailConfirmation": {
            "type": "boolean"
          }
        }
      },
      "ResetPasswordRequest": {
        "required": [
          "userId",
          "code",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "maxLength": 2048,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 256,
            "type": "string"
          }
        }
      },
      "SignInRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Nails.Api"
    },
    {
      "name": "Tickets"
    },
    {
      "name": "Account"
    },
    {
      "name": "Session"
    },
    {
      "name": "Help"
    }
  ]
}