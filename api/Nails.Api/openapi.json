    "/api/masters/search": {
      "get": {
        "tags": [
          "Masters"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "maxLength": 40,
              "type": "string"
            }
          },
          {
            "name": "subcategoryId",
            "in": "query",
            "schema": {
              "maxLength": 40,
              "type": "string"
            }
          },
          {
            "name": "priceFrom",
            "in": "query",
            "schema": {
              "maximum": 100000,
              "minimum": 0,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "priceTo",
            "in": "query",
            "schema": {
              "maximum": 100000,
              "minimum": 0,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "maxDistanceKm",
            "in": "query",
            "schema": {
              "maximum": 1000,
              "minimum": 0.1,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "schema": {
              "maximum": 5,
              "minimum": 1,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "online",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "window",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/SearchWindow"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "maxLength": 60,
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/SearchSort"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterSearchResponse"
                }
              }
            }
          }
        }
      }
    },
