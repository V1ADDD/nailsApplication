    "/api/help/content": {
      "get": {
        "tags": [
          "Help"
        ],
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelpContentResponse"
                }
              }
            }
          }
        }
      }
    }
