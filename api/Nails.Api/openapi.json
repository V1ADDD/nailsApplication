{
  "openapi": "3.1.1",
  "info": {
    "title": "Nails.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/modules": {
      "get": {
        "tags": [
          "Nails.Api"
        ],
        "operationId": "GetModules",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModulesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/support/tickets": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSupportTicketRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSupportTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSupportTicketResponse"
                }
              }
            }
          }
        }
      }
    },
