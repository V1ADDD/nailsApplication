  "components": {
    "schemas": {
      "BookingResponse": {
        "required": [
          "id",
          "masterId",
          "clientUserId",
          "slotId",
          "subcategoryId",
          "serviceName",
          "price",
          "start",
          "durationMin",
          "address",
          "status",
          "source",
          "createdBy",
          "confirmedAt",
          "releaseAt",
          "cancelledAt",
          "cancelledBy",
          "cancelReason",
          "cancelMutual",
          "cancelExpired",
          "masterName",
          "masterPhotoUrl",
          "clientName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "masterId": {
            "type": "string",
            "format": "uuid"
          },
          "clientUserId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "slotId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "subcategoryId": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/PriceResponse"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationMin": {
            "type": "integer",
            "format": "int32"
          },
          "address": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "source": {
            "$ref": "#/components/schemas/BookingSource"
          },
          "createdBy": {
            "$ref": "#/components/schemas/Party"
          },
          "confirmedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "releaseAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "cancelledBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Party"
              }
            ]
          },
          "cancelReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "cancelMutual": {
            "type": "boolean"
          },
          "cancelExpired": {
            "type": "boolean"
          },
          "masterName": {
            "type": "string"
          },
          "masterPhotoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientName": {
            "type": "string"
          }
        }
      },
      "BookingSource": {
        "enum": [
          "site",
          "external"
        ]
      },
      "BookingStatus": {
        "enum": [
          "pending",
          "confirmed",
          "cancelled",
          "completed",
          "noShow"
        ]
      },
      "BookingSummaryResponse": {
        "required": [
          "id",
          "masterName",
          "serviceName",
          "start",
          "durationMin",
          "address"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "masterName": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationMin": {
            "type": "integer",
            "format": "int32"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "CancelBookingRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "mutual": {
            "type": "boolean"
          }
        }
      },
      "CardServiceResponse": {
        "required": [
          "subcategoryId",
          "name",
          "price",
          "durationMin"
        ],
        "type": "object",
        "properties": {
          "subcategoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/PriceResponse"
          },
          "durationMin": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CategoryResponse": {
        "required": [
          "id",
          "name",
          "specialty",
          "subcategories"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "specialty": {
            "type": "string"
          },
          "subcategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubcategoryResponse"
            }
          }
        }
      },
      "ConflictsRequest": {
        "required": [
          "slotId"
        ],
        "type": "object",
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ConflictsResponse": {
        "required": [
          "overlapping",
          "tooClose"
        ],
        "type": "object",
        "properties": {
          "overlapping": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingSummaryResponse"
            }
          },
          "tooClose": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingSummaryResponse"
            }
          }
        }
      },
      "ContactsResponse": {
        "required": [
          "phone",
          "email",
          "telegram",
          "viber",
          "instagram"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "telegram": {
            "type": [
              "null",
              "string"
            ]
          },
          "viber": {
            "type": [
              "null",
              "string"
            ]
          },
          "instagram": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CourseResponse": {
        "required": [
          "title",
          "school",
          "year"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "school": {
            "type": "string"
          },
          "year": {
            "type": "integer",
