{
  "openapi": "3.1.1",
  "info": {
    "title": "Nails.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/modules": {
      "get": {
        "tags": [
          "Nails.Api"
        ],
        "operationId": "GetModules",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModulesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/support/tickets": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSupportTicketRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSupportTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSupportTicketResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/sign-in/code": {
      "post": {
        "tags": [
          "Session"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneCodeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneCodeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/sign-in": {
      "post": {
        "tags": [
          "Session"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/sign-out": {
      "post": {
        "tags": [
          "Session"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/identity/me": {
      "get": {
        "tags": [
          "Session"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/help/content": {
      "get": {
        "tags": [
          "Help"
        ],
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelpContentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/help/images/{language}/{articleId}/{fileName}": {
      "get": {
        "tags": [
          "Help"
        ],
        "parameters": [
          {
            "name": "language",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "articleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSupportTicketRequest": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 2000,
            "type": "string"
          },
          "contact": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateSupportTicketResponse": {
        "required": [
          "ticketId"
        ],
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HelpArticleResponse": {
        "required": [
          "id",
          "title",
          "summary",
          "keywords",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HelpBlockResponse"
            }
          }
        }
      },
      "HelpBlockResponse": {
        "required": [
          "type",
          "text",
          "tone",
          "items",
          "articleIds",
          "image"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/HelpBlockType"
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "tone": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HelpNoteTone"
              }
            ]
          },
          "items": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "articleIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "image": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HelpImageResponse"
              }
            ]
          }
        }
      },
      "HelpBlockType": {
        "enum": [
          "heading",
          "paragraph",
          "list",
          "steps",
          "note",
          "related",
          "image"
        ]
      },
      "HelpCompanyResponse": {
        "required": [
          "name",
          "email",
          "website"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        }
      },
      "HelpContentResponse": {
        "required": [
          "site",
          "company",
          "sections"
        ],
        "type": "object",
        "properties": {
          "site": {
            "$ref": "#/components/schemas/HelpSiteResponse"
          },
          "company": {
            "$ref": "#/components/schemas/HelpCompanyResponse"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HelpSectionResponse"
            }
          }
        }
      },
      "HelpImageResponse": {
        "required": [
          "url",
          "alt",
          "caption",
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": [
              "null",
              "string"
            ]
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HelpNoteTone": {
        "enum": [
          "info",
          "tip",
          "warning",
          null
        ]
      },
      "HelpSectionResponse": {
        "required": [
          "id",
          "title",
          "articles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "articles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HelpArticleResponse"
            }
          }
        }
      },
      "HelpSiteResponse": {
        "required": [
          "title",
          "description"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "name",
          "phone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ModulesResponse": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PhoneCodeRequest": {
        "required": [
          "phone"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "maxLength": 32,
            "type": "string"
          }
        }
      },
      "PhoneCodeResponse": {
        "required": [
          "codeLength",
          "resendAfterSeconds"
        ],
        "type": "object",
        "properties": {
          "codeLength": {
            "type": "integer",
            "format": "int32"
          },
          "resendAfterSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SignInRequest": {
        "required": [
          "phone",
          "code"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "maxLength": 32,
            "type": "string"
          },
          "code": {
            "maxLength": 8,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SignInResponse": {
        "required": [
          "nameRequired"
        ],
        "type": "object",
        "properties": {
          "nameRequired": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Nails.Api"
    },
    {
      "name": "Tickets"
    },
    {
      "name": "Session"
    },
    {
      "name": "Help"
    }
  ]
}